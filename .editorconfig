# https://EditorConfig.org
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

# Pas de charset imposé : certains fichiers .csproj, .xaml et .cs sont en
# UTF-8 avec BOM, d'autres sans.

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,js,css,html,csproj,slnx}]
indent_size = 2
